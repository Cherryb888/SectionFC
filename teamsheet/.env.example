# Leave these blank to run in local mode: everything is saved in the browser,
# nothing leaves the device, and "Unlock" simulates the payment. Good for
# trying it out. Fill them in to run it for real.

# Firebase web config for the Teamsheet project (NOT the section-fc project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe Payment Link for the £3 unlock, e.g. https://buy.stripe.com/xxxx
# The app adds ?client_reference_id=<team id> so the webhook knows which team paid.
VITE_STRIPE_PAYMENT_LINK=
